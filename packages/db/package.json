{
  "name": "@hot-potato/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "bootstrap": "node dist/bootstrap.js",
    "migrate": "node dist/migrate.js",
    "seed": "node dist/seed.js",
    "test": "vitest run --config vitest.config.ts",
    "test:integration": "node dist/integration-smoke.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:booking-integration": "node test/booking-cancellation.integration.mjs"
  },
  "dependencies": {
    "@hot-potato/router": "*",
    "postgres": "3.4.9"
  },
  "devDependencies": {
    "vitest": "4.1.11"
  }
}
