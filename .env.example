DATABASE_URL=postgres://hotpotato:hotpotato@localhost:5432/hotpotato
HOT_POTATO_ORG=acme
HOT_POTATO_ORG_NAME=Hot Potato Workspace
PORT=3000
APP_URL=http://localhost:3000

# Trust exactly one client-IP header only when the origin is reachable solely
# through a proxy that overwrites it (for Cloudflare: cf-connecting-ip).
TRUSTED_PROXY_CLIENT_IP_HEADER=

# Required named owner login for the operator workspace. Bootstrap stores a
# scrypt password hash. Use at least 12 characters; the web process never
# receives it and normal restarts never overwrite an in-app password change.
HOT_POTATO_ADMIN_USER=owner@example.com
HOT_POTATO_ADMIN_NAME=Workspace Owner
HOT_POTATO_ADMIN_PASSWORD=
# Set true only for an intentional owner-password recovery, run bootstrap once,
# then return it to false. Normal in-app password changes survive restarts.
HOT_POTATO_RESET_ADMIN_PASSWORD=false

# Generate with: openssl rand -base64 32
OAUTH_ENCRYPTION_KEY=

HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Google Workspace HTTP add-on identity (separate from Calendar OAuth).
GOOGLE_WORKSPACE_ADDON_OAUTH_CLIENT_ID=
GOOGLE_WORKSPACE_ADDON_SERVICE_ACCOUNT_EMAIL=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# Outlook task-pane identity (separate from Calendar OAuth). Use the same Entra
# application GUID when rendering the Outlook manifest. Hot Potato derives the
# api://<APP_URL host>/<client-id>/access_as_user delegated scope; Entra v2
# access tokens carry the client GUID itself in the audience claim.
OUTLOOK_NAA_CLIENT_ID=

# Optional SMTP delivery for Hot Potato confirmations and reminders.
# Without these values, messages are logged locally while calendar invitations
# are still sent by Google or Microsoft.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Hot Potato <scheduling@example.com>

# Abort one external worker operation before its five-minute claim lease can
# be reclaimed by another worker. Values are clamped to 30,000–240,000 ms.
WORKER_OPERATION_TIMEOUT_MS=120000
